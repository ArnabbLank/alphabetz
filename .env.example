# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses all Row Level Security.
# Must never carry a NEXT_PUBLIC_ prefix and must never reach client code.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (ALZ-93). Test keys in development, live keys only in production.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 SMS / OTP delivery (ALZ-34)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Preview gate (temporary). When set, the WHOLE site sits behind HTTP Basic Auth
# and robots returns Disallow: /. Any username works; only the password is checked.
# Leave UNSET locally and in CI. Remove once ALZ-27 and ALZ-46 land.
PREVIEW_GATE_PASSWORD=
